{
  "name": "@forgeboard/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain": {
      "types": "./src/model/domain.ts",
      "default": "./src/model/domain.ts"
    },
    "./permissions": {
      "types": "./src/permissions/contracts.ts",
      "default": "./src/permissions/contracts.ts"
    },
    "./collaboration-delivery": {
      "types": "./src/collaboration/delivery-contracts.ts",
      "default": "./src/collaboration/delivery-contracts.ts"
    },
    "./collaboration-delivery-codec": {
      "types": "./src/collaboration/delivery-codec.ts",
      "default": "./src/collaboration/delivery-codec.ts"
    },
    "./workflow-runtime": {
      "types": "./src/workflow-runtime/index.ts",
      "default": "./src/workflow-runtime/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --root ../.. --project unit packages/core/src",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
