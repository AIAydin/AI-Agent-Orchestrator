{
  "name": "@forgeboard/git-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --root ../.. --project unit packages/git-engine/src",
    "test:integration": "vitest run --root ../.. --project integration packages/git-engine/src"
  },
  "dependencies": {
    "@forgeboard/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "3.2.4"
  }
}
