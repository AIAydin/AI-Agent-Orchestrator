{
  "name": "@forgeboard/agent-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./identifiers": {
      "types": "./src/identifiers.ts",
      "default": "./src/identifiers.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project unit src/adapter.test.ts src/docker.test.ts"
  },
  "dependencies": {
    "node-pty": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:"
  }
}
