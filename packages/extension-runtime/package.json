{
  "name": "@forgeboard/extension-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run --root ../.. --project unit packages/extension-runtime/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forgeboard/agent-adapters": "workspace:*",
    "@forgeboard/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
