{
  "name": "@forgeboard/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first visual workshop for software-building agents.",
  "desktopName": "forgeboard.desktop",
  "homepage": "https://github.com/AIAydin/AI-Agent-Orchestrator",
  "author": {
    "name": "Forgeboard contributors",
    "email": "AIAydin@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "corepack pnpm --dir ../../packages/test-agent build",
    "dev": "electron-vite dev",
    "prebuild": "corepack pnpm --dir ../../packages/test-agent build",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "corepack pnpm build",
    "test:e2e": "playwright test",
    "package": "corepack pnpm build && electron-builder --publish never",
    "package:dir": "corepack pnpm build && electron-builder --dir --publish never",
    "smoke:packaged": "tsx scripts/smoke-packaged.ts",
    "smoke:installer": "tsx scripts/smoke-installer.ts"
  },
  "dependencies": {
    "@forgeboard/agent-adapters": "workspace:*",
    "@forgeboard/core": "workspace:*",
    "@forgeboard/extension-runtime": "workspace:*",
    "@forgeboard/git-engine": "workspace:*",
    "@forgeboard/test-agent": "workspace:*",
    "@forgeboard/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@xyflow/react": "catalog:",
    "dugite": "3.2.2",
    "lucide-react": "catalog:",
    "monaco-editor": "catalog:",
    "node-pty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "build": {
    "appId": "dev.forgeboard.desktop",
    "productName": "Forgeboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-pty/**",
      "**/dugite/git/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../docs/legal/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../third_party/git/COPYING",
        "to": "licenses/git/COPYING"
      },
      {
        "from": "../../packages/test-agent/dist",
        "to": "test-agent",
        "filter": [
          "cli.js",
          "cli.js.map",
          "chunk-*.js",
          "chunk-*.js.map"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "executableName": "forgeboard",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "deb": {
      "artifactName": "forgeboard_${version}_${arch}.${ext}",
      "packageName": "forgeboard"
    }
  }
}
